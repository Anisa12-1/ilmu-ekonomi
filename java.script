const lessonModal = document.getElementById("lessonModal");
const modalTitle = document.getElementById("modalTitle");
const modalBody = document.getElementById("modalBody");
const closeModal = document.getElementById("closeModal");
const modalDone = document.getElementById("modalDone");
let lastFocusedElement = null;

function addParagraph(parent, text) {
    const p = document.createElement("p");
    p.textContent = text;
    parent.appendChild(p);
}

function openLesson(key) {
    const lesson = lessons[key];
    if (!lesson) return;

    lastFocusedElement = document.activeElement;
    modalTitle.textContent = lesson.title;
    modalBody.replaceChildren();

    lesson.paragraphs.forEach(function (paragraph) {
        addParagraph(modalBody, paragraph);
    });

    const heading = document.createElement("h3");
    heading.textContent = lesson.heading;
    modalBody.appendChild(heading);

    const list = document.createElement("ul");

    lesson.points.forEach(function (point) {
        const li = document.createElement("li");
        li.textContent = point;
        list.appendChild(li);
    });

    modalBody.appendChild(list);

    const exampleHeading = document.createElement("h3");
    exampleHeading.textContent = "Contoh dalam kehidupan sehari-hari";
    modalBody.appendChild(exampleHeading);
    addParagraph(modalBody, lesson.example);

    lessonModal.hidden = false;
    document.body.style.overflow = "hidden";
    closeModal.focus();
}

function hideLesson() {
    lessonModal.hidden = true;
    document.body.style.overflow = "";
    if (lastFocusedElement) lastFocusedElement.focus();
}

document.querySelectorAll("[data-open]").forEach(function (button) {
    button.addEventListener("click", function () {
        openLesson(button.dataset.open);
    });
});

closeModal.addEventListener("click", hideLesson);
modalDone.addEventListener("click", hideLesson);

lessonModal.querySelector("[data-close-modal]")
    .addEventListener("click", hideLesson);

document.addEventListener("keydown", function (event) {
    if (!lessonModal.hidden && event.key === "Escape") {
        hideLesson();
    }
});


/* =====================================
   4. FUNGSI VALIDASI DAN FORMAT RUPIAH
===================================== */

const rupiah = new Intl.NumberFormat("id-ID", {
    style: "currency",
    currency: "IDR",
    maximumFractionDigits: 0
});

function readNumber(id) {
    const input = document.getElementById(id);
    const raw = input.value.trim();
    const value = Number(raw);

    if (
        raw === "" ||
        !Number.isFinite(value) ||
        value < 0
    ) {
        return null;
    }

    return value;
}

function showResult(id, message) {
    document.getElementById(id).textContent = message;
}


/* =====================================
   5. KALKULATOR ANGGARAN
===================================== */

document.getElementById("budgetBtn")
    .addEventListener("click", function () {
        const income = readNumber("income");
        const expense = readNumber("expense");

        if (income === null || expense === null) {
            showResult(
                "budgetResult",
                "Isi kedua kolom dengan angka yang valid dan tidak negatif."
            );
            return;
        }

        const remaining = income - expense;

        if (remaining > 0) {
            showResult(
                "budgetResult",
                "Sisa uang: " + rupiah.format(remaining) +
                ". Pertimbangkan kebutuhan mendatang dan dana darurat."
            );
        } else if (remaining === 0) {
            showResult(
                "budgetResult",
                "Anggaran seimbang. Seluruh uang yang dihitung telah dialokasikan."
            );
        } else {
            showResult(
                "budgetResult",
                "Defisit: " + rupiah.format(Math.abs(remaining)) +
                ". Pengeluaran melebihi uang yang tersedia."
            );
        }
    });


/* =====================================
   6. KALKULATOR LABA USAHA
===================================== */

document.getElementById("profitBtn")
    .addEventListener("click", function () {
        const units = readNumber("units");
        const price = readNumber("price");
        const cost = readNumber("cost");

        if (units === null || price === null || cost === null) {
            showResult(
                "profitResult",
                "Isi semua kolom dengan angka valid dan tidak negatif."
            );
            return;
        }

        if (
            !Number.isSafeInteger(units) ||
            units > 1000000000 ||
            !Number.isSafeInteger(price) ||
            price > 1000000000000 ||
            !Number.isSafeInteger(cost) ||
            cost > 100000000000000
        ) {
            showResult(
                "profitResult",
                "Gunakan bilangan bulat dalam batas yang wajar."
            );
            return;
        }

        const revenue = units * price;
        const profit = revenue - cost;

        if (!Number.isSafeInteger(revenue) || !Number.isSafeInteger(profit)) {
            showResult(
                "profitResult",
                "Angka terlalu besar untuk dihitung dengan aman."
            );
            return;
        }

        const margin = revenue > 0
            ? (profit / revenue) * 100
            : null;

        let message =
            "Omzet: " + rupiah.format(revenue) +
            "\nTotal biaya: " + rupiah.format(cost);

        if (profit > 0) {
            message += "\nLaba sederhana: " + rupiah.format(profit);
        } else if (profit === 0) {
            message += "\nHasil: impas berdasarkan biaya yang dimasukkan.";
        } else {
            message += "\nRugi sederhana: " + rupiah.format(Math.abs(profit));
        }

        if (margin !== null) {
            message += "\nMargin laba: " + margin.toFixed(2) + "%";
        } else {
            message += "\nMargin tidak dapat dihitung karena omzet nol.";
        }

        showResult("profitResult", message);
    });


/* =====================================
   7. SIMULASI TABUNGAN
===================================== */

document.getElementById("savingBtn")
    .addEventListener("click", function () {
        const initial = readNumber("saving");
        const monthly = readNumber("monthly");
        const months = readNumber("months");

        if (
            initial === null ||
            monthly === null ||
            months === null ||
            months < 1 ||
            months > 600 ||
            !Number.isSafeInteger(months) ||
            !Number.isSafeInteger(initial) ||
            !Number.isSafeInteger(monthly)
        ) {
            showResult(
                "savingResult",
                "Masukkan tabungan awal dan setoran bulanan berupa bilangan bulat tidak negatif, serta durasi 1–600 bulan."
            );
            return;
        }

        const total = initial + monthly * months;

        if (!Number.isSafeInteger(total)) {
            showResult(
                "savingResult",
                "Angka terlalu besar untuk dihitung dengan aman."
            );
            return;
        }

        showResult(
            "savingResult",
            "Perkiraan tabungan setelah " + months +
            " bulan: " + rupiah.format(total) +
            ". Perhitungan ini belum memperhitungkan bunga, biaya, dan inflasi."
        );
    });


/* =====================================
   8. KUIS ILMU EKONOMI
===================================== */

const questions = [
    {
        question: "1. Mengapa kelangkaan menjadi masalah dasar ekonomi?",
        options: [
            "Karena semua barang selalu gratis",
            "Karena sumber daya terbatas sementara kebutuhan beragam",
            "Karena manusia tidak memiliki kebutuhan",
            "Karena harga semua barang sama"
        ],
        answer: 1,
        explanation: "Sumber daya terbatas membuat manusia perlu menentukan prioritas."
    },
    {
        question: "2. Kegiatan menghasilkan barang disebut ...",
        options: ["Konsumsi", "Distribusi", "Produksi", "Inflasi"],
        answer: 2,
        explanation: "Produksi menghasilkan atau menambah nilai guna barang dan jasa."
    },
    {
        question: "3. Apa yang dimaksud biaya peluang?",
        options: [
            "Semua uang yang disimpan",
            "Nilai alternatif terbaik yang dikorbankan",
            "Total jumlah barang yang dibeli",
            "Pajak yang selalu dibayar perusahaan"
        ],
        answer: 1,
        explanation: "Biaya peluang adalah nilai alternatif terbaik yang dilepaskan saat memilih."
    },
    {
        question: "4. Apa arti inflasi?",
        options: [
            "Harga satu barang pasti turun",
            "Kenaikan harga saham saja",
            "Kenaikan harga secara umum dan berkelanjutan",
            "Penurunan semua pendapatan"
        ],
        answer: 2,
        explanation: "Inflasi adalah kenaikan harga barang dan jasa secara umum dan berkelanjutan."
    },
    {
        question: "5. Omzet usaha adalah ...",
        options: [
            "Total nilai penjualan",
            "Total uang yang dipinjam",
            "Laba setelah semua biaya",
            "Jumlah karyawan"
        ],
        answer: 0,
        explanation: "Omzet merupakan total penjualan, bukan laba bersih."
    },
    {
        question: "6. Jika pendapatan Rp500.000 dan pengeluaran Rp350.000, sisanya adalah ...",
        options: [
            "Rp100.000",
            "Rp150.000",
            "Rp200.000",
            "Rp850.000"
        ],
        answer: 1,
        explanation: "Rp500.000 dikurangi Rp350.000 sama dengan Rp150.000."
    },
    {
        question: "7. Apa yang dipelajari ekonomi mikro?",
        options: [
            "Hanya hubungan antarnegara",
            "Keputusan konsumen dan perusahaan",
            "Hanya cuaca dunia",
            "Hanya jumlah penduduk"
        ],
        answer: 1,
        explanation: "Ekonomi mikro mempelajari keputusan rumah tangga, konsumen, dan perusahaan."
    },
    {
        question: "8. Apa tujuan utama membuat anggaran pribadi?",
        options: [
            "Menghabiskan uang secepatnya",
            "Menghindari pencatatan pengeluaran",
            "Merencanakan pendapatan dan pengeluaran",
            "Selalu membeli barang mahal"
        ],
        answer: 2,
        explanation: "Anggaran membantu merencanakan penggunaan uang sesuai kebutuhan dan tujuan."
    },
    {
        question: "9. Dalam ekonomi syariah, akad membantu menjelaskan ...",
        options: [
            "Kesepakatan dan ketentuan transaksi",
            "Warna semua produk",
            "Cuaca saat transaksi",
            "Jumlah penduduk"
        ],
        answer: 0,
        explanation: "Akad menjelaskan kesepakatan dan ketentuan transaksi sesuai jenis akadnya."
    },
    {
        question: "10. Jika omzet Rp1.000.000 dan total biaya Rp700.000, laba sederhananya adalah ...",
        options: [
            "Rp100.000",
            "Rp200.000",
            "Rp300.000",
            "Rp1.700.000"
        ],
        answer: 2,
        explanation: "Laba sederhana adalah Rp1.000.000 dikurangi Rp700.000, yaitu Rp300.000."
    }
];

const questionElement = document.getElementById("question");
const optionsElement = document.getElementById("options");
const questionNumber = document.getElementById("questionNumber");
const quizPoints = document.getElementById("quizPoints");
const quizFeedback = document.getElementById("quizFeedback");
const progressBar = document.getElementById("progressBar");
const nextQuestion = document.getElementById("nextQuestion");

let currentQuestion = 0;
let score = 0;
let answered = false;
let quizFinished = false;

function showQuestion() {
    answered = false;
    quizFinished = false;

    const item = questions[currentQuestion];

    questionElement.textContent = item.question;
    questionNumber.textContent =
        "Pertanyaan " + (currentQuestion + 1) +
        " dari " + questions.length;

    quizPoints.textContent = "Nilai: " + score;
    progressBar.style.width =
        ((currentQuestion + 1) / questions.length * 100) + "%";

    quizFeedback.textContent = "";
    quizFeedback.className = "";
    optionsElement.replaceChildren();

    item.options.forEach(function (option, index) {
        const button = document.createElement("button");

        button.type = "button";
        button.className = "option-btn";
        button.textContent = option;

        button.addEventListener("click", function () {
            checkAnswer(index);
        });

        optionsElement.appendChild(button);
    });

    nextQuestion.disabled = true;
    nextQuestion.textContent =
        currentQuestion === questions.length - 1
            ? "Lihat Hasil Akhir"
            : "Pertanyaan Berikutnya →";
}

function checkAnswer(selectedIndex) {
    if (answered || quizFinished) return;

    answered = true;

    const item = questions[currentQuestion];
    const buttons = optionsElement.querySelectorAll(".option-btn");
    const isCorrect = selectedIndex === item.answer;

    if (isCorrect) {
        score++;
    }

    buttons.forEach(function (button, index) {
        button.disabled = true;

        if (index === item.answer) {
            button.classList.add("correct");
        }

        if (index === selectedIndex && !isCorrect) {
            button.classList.add("wrong");
        }
    });

    quizFeedback.textContent =
        (isCorrect ? "Benar! " : "Belum tepat. ") +
        item.explanation;

    quizFeedback.className = isCorrect ? "success" : "error";
    quizPoints.textContent = "Nilai: " + score;
    nextQuestion.disabled = false;
}

function showFinalResult() {
    quizFinished = true;
    progressBar.style.width = "100%";

    questionElement.textContent = "Kuis Selesai! 🎉";
    questionNumber.textContent = "Hasil akhir";
    quizPoints.textContent = "Nilai: " + score + "/" + questions.length;
    optionsElement.replaceChildren();

    const percentage = score / questions.length * 100;

    let message;

    if (percentage === 100) {
        message = "Sempurna! Kamu menjawab semua pertanyaan dengan benar.";
    } else if (percentage >= 70) {
        message = "Bagus! Kamu sudah memahami banyak konsep ekonomi.";
    } else {
        message = "Tetap semangat! Baca kembali materi dan coba lagi.";
    }

    quizFeedback.textContent =
        message + " Nilai kamu: " + percentage + "/100.";
    quizFeedback.className = percentage >= 70 ? "success" : "";

    nextQuestion.disabled = false;
    nextQuestion.textContent = "Ulangi Kuis ↻";
}

nextQuestion.addEventListener("click", function () {
    if (quizFinished) {
        currentQuestion = 0;
        score = 0;
        showQuestion();
        return;
    }

    if (!answered) return;

    if (currentQuestion < questions.length - 1) {
        currentQuestion++;
        showQuestion();
    } else {
        showFinalResult();
    }
});


/* =====================================
   9. JALANKAN SAAT HALAMAN DIBUKA
===================================== */

showQuestion();
filterMaterials();

